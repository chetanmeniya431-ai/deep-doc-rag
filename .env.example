# Which compose files to use.
# Laptop: leave empty (uses docker-compose.override.yml if you made one).
# Server: COMPOSE_FILE=docker-compose.yml:docker-compose.shared-ollama.yml:docker-compose.prod.yml
COMPOSE_FILE=

# Port the web app listens on (host side).
APP_PORT=8012

# Where PDFs, the index and downloaded models live (inside the container).
DATA_DIR=/app/data

# 1 = build the 150-page demo PDF on first start.
AUTO_DEMO=1

# Free local LLM through Ollama. Leave OLLAMA_URL empty to use answer-by-quotes mode (no LLM).
OLLAMA_URL=http://ollama:11434
# Small model for laptops (about 1.1 GB RAM).
# Server: llama3.2:3b, the one model every Nirmantra demo shares in the same Ollama.
LLM_MODEL=qwen2.5:1.5b
# Free the LLM from RAM after this much idle time.
LLM_KEEP_ALIVE=2m
LLM_TIMEOUT=240
LLM_CONTEXT_TOKENS=4096

# Optional: a free vision model in Ollama (e.g. moondream) that describes charts during ingest.
# Off by default. Needs about 2 GB disk and works best on the server.
VLM_MODEL=

# Free ONNX models (downloaded once, run on CPU).
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Public demo guards (the prod compose file sets PUBLIC_DEMO=1):
# the demo PDF cannot be deleted, uploads are capped, and the LLM eval is hidden.
PUBLIC_DEMO=0
MAX_UPLOAD_MB=20
MAX_UPLOAD_PAGES=80
MAX_DOCS=10

# Resource limits (keep the machine responsive).
APP_MEM_LIMIT=2g
APP_CPUS=2.5
MODEL_THREADS=2
EMBED_BATCH=16

# Retrieval knobs.
TOP_K=6
CANDIDATES=40
